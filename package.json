{
  "name": "@fyrlabs/dead-drop-shell",
  "version": "0.1.0",
  "description": "Line-oriented remote shell over dead-drop, for machines you cannot reach over SSH",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "dead-drop",
    "remote-shell",
    "git",
    "github"
  ],
  "bin": {
    "ddshell": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@fyrlabs/dead-drop": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
