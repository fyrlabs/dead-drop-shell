{
  "name": "@fyrlabs/dead-drop-shell",
  "version": "0.2.0",
  "description": "A remote shell over dead-drop: an alternative to SSH that needs no inbound port, VPN or tunnel",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyrlabs/dead-drop-shell.git"
  },
  "homepage": "https://github.com/fyrlabs/dead-drop-shell#readme",
  "bugs": "https://github.com/fyrlabs/dead-drop-shell/issues",
  "keywords": [
    "dead-drop",
    "remote-shell",
    "git",
    "github"
  ],
  "bin": {
    "ddshell": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fyrlabs/dead-drop": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
